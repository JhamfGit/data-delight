# Copy to .env and fill in real values. Never commit the real .env file.

# URL del backend API (frontend build-time var)
VITE_API_URL=https://registros.regency.jhamf.com

# JWT secret -- REQUIRED, no fallback default (server refuses to start
# without it, see server.js). Use a long, random, unguessable value.
JWT_SECRET=

# MySQL connection (see server.js)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
